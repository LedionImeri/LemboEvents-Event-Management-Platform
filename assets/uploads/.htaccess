# User uploads: serve images only, never execute scripts
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|htaccess|svg|html?)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp)$">
        Header set Content-Security-Policy "default-src 'none'"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
