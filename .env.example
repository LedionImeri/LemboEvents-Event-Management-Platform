# LemboEvents — environment variables (alternative to config/local.php)
# Values in config/local.php take precedence. Never commit real values.

APP_ENV=development
APP_SECRET=replace-with-a-long-random-string
# BASE_URL=/LemboEvents

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lemboevents
DB_USER=root
DB_PASS=

# LemboBot (Groq, OpenAI-compatible API). Leave empty to run LemboBot in basic (rule-based) mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# CHATBOT_CA_BUNDLE=C:/xampp/php/extras/ssl/cacert.pem
